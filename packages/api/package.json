{
  "name": "@sess/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:node": "node --loader ts-node/esm src/node.ts",
    "start:node": "node dist/node.js",
    "build": "tsup",
    "types": "wrangler types src/worker-configuration.d.ts",
    "deploy": "wrangler deploy",
    "kv:seed": "wrangler kv key put --binding=DATA_KV semester_data --path=../../apps/web/src/data/data.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.11.0",
    "@hono/zod-validator": "^0.2.2",
    "@sess/core": "workspace:*",
    "hono": "^4.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240605.0",
    "@types/node": "^20.12.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}