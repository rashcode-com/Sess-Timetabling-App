# SESS Portal Credentials
SESS_URL="https://sess.sku.ac.ir/"
SESS_USERNAME=""
SESS_PASSWORD=""

# Scraping Configuration
SEMESTER_VALUE="4031"
HEADLESS="true"
# Filter specific departments by name (comma-separated, Persian/Arabic compatible, or leave empty for all)
DEPARTMENTS="بخش مهندسی کامپیوتر, بخش علوم کامپیوتر"
# Browser: "msedge", "chrome", or leave empty/default for Playwright Chromium
BROWSER_CHANNEL="msedge"
OUTPUT_PATH="../../apps/web/src/data/data.json"

# Optional Sync to @sess/api
API_URL="http://localhost:3000"
SYNC_TOKEN=""
