{
  "name": "@sess/web",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.vue",
    "test": "node tests/courseDataService.test.mjs && node tests/stores.test.mjs"
  },
  "imports": {
    "@/*": "./src/*",
    "@shared": "./src/shared/index.js",
    "@features/*": "./src/features/*"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@sess/core": "workspace:*",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/eslint-parser": "^7.25.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/compiler-sfc": "^3.5.13",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.20.0",
    "sass-embedded": "^1.80.0",
    "vite": "^6.0.0",
    "vite-plugin-vuetify": "^2.0.4"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "browser": true,
      "node": true,
      "es2021": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false,
      "babelOptions": {
        "babelrc": false,
        "configFile": false
      },
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "globals": {
      "__APP_VERSION__": "readonly"
    },
    "rules": {
      "vue/multi-word-component-names": "off",
      "vue/valid-v-slot": [
        "error",
        {
          "allowModifiers": true
        }
      ],
      "no-restricted-imports": [
        "error",
        {
          "patterns": [
            "@/features/*/components/*",
            "@/features/*/*/*"
          ]
        }
      ]
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}